{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "@monark/ui",
  "homepage": "https://ui.monark.io",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Monark Theme",
      "description": "Monark 2026 brand: warm cream light mode and espresso dark mode derived from the flat orange primary (CSS relative color, scaled by --surface-tint), dark text on orange, Nunito Sans, a 1rem radius with the full radius scale, and the base styles, focus outline, pointer cursors on controls, motion reset, the animate-expand panel animation and typography utilities (eyebrow, tracking-display, tnum) Monark sites share. Install this first so every component inherits the Monark look. Browsers without relative color get the same colors as fixed values.",
      "dependencies": [
        "shadcn",
        "tw-animate-css"
      ],
      "cssVars": {
        "theme": {
          "radius": "1rem",
          "radius-sm": "calc(var(--radius) * 0.5)",
          "radius-md": "calc(var(--radius) * 0.75)",
          "radius-lg": "var(--radius)",
          "radius-xl": "calc(var(--radius) * 1.25)",
          "radius-2xl": "calc(var(--radius) * 1.5)",
          "radius-3xl": "calc(var(--radius) * 2)",
          "radius-4xl": "calc(var(--radius) * 2.5)",
          "font-sans": "\"Nunito Sans\", ui-sans-serif, system-ui, -apple-system, sans-serif",
          "font-heading": "var(--font-sans)",
          "font-mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, \"Cascadia Mono\", monospace",
          "color-primary": "var(--primary)",
          "color-background": "var(--background)",
          "color-foreground": "var(--foreground)",
          "color-card": "var(--card)",
          "color-card-foreground": "var(--card-foreground)",
          "color-popover": "var(--popover)",
          "color-popover-foreground": "var(--popover-foreground)",
          "color-primary-foreground": "var(--primary-foreground)",
          "color-secondary": "var(--secondary)",
          "color-secondary-foreground": "var(--secondary-foreground)",
          "color-muted": "var(--muted)",
          "color-muted-foreground": "var(--muted-foreground)",
          "color-accent": "var(--accent)",
          "color-accent-foreground": "var(--accent-foreground)",
          "color-destructive": "var(--destructive)",
          "color-destructive-foreground": "var(--destructive-foreground)",
          "color-border": "var(--border)",
          "color-input": "var(--input)",
          "color-ring": "var(--ring)",
          "color-primary-ink": "var(--primary-ink)",
          "color-success": "var(--success)",
          "color-warning": "var(--warning)",
          "color-overlay": "var(--overlay)",
          "color-chart-1": "var(--chart-1)",
          "color-chart-2": "var(--chart-2)",
          "color-chart-3": "var(--chart-3)",
          "color-chart-4": "var(--chart-4)",
          "color-chart-5": "var(--chart-5)",
          "color-sidebar": "var(--sidebar)",
          "color-sidebar-foreground": "var(--sidebar-foreground)",
          "color-sidebar-primary": "var(--sidebar-primary)",
          "color-sidebar-primary-foreground": "var(--sidebar-primary-foreground)",
          "color-sidebar-accent": "var(--sidebar-accent)",
          "color-sidebar-accent-foreground": "var(--sidebar-accent-foreground)",
          "color-sidebar-border": "var(--sidebar-border)",
          "color-sidebar-ring": "var(--sidebar-ring)"
        },
        "light": {
          "surface-tint": "1",
          "primary": "#f88d10",
          "background": "#fff9f3",
          "foreground": "#15110e",
          "card": "#fffefc",
          "card-foreground": "var(--foreground)",
          "popover": "var(--card)",
          "popover-foreground": "var(--foreground)",
          "primary-foreground": "var(--foreground)",
          "secondary": "#f7ece4",
          "secondary-foreground": "var(--foreground)",
          "muted": "var(--secondary)",
          "muted-foreground": "#625952",
          "accent": "var(--secondary)",
          "accent-foreground": "var(--foreground)",
          "destructive": "#c81e0b",
          "destructive-foreground": "#ffffff",
          "border": "#e9dfd7",
          "input": "#857f7a",
          "ring": "var(--primary-ink)",
          "primary-ink": "#b65000",
          "success": "#2f7a4a",
          "warning": "#8a5a00",
          "overlay": "oklch(0 0 0 / 0.45)",
          "chart-1": "var(--primary)",
          "chart-2": "#ef3620",
          "chart-3": "#7a5c3e",
          "chart-4": "#c8a27a",
          "chart-5": "#424242",
          "sidebar": "#fdf5efd9",
          "sidebar-foreground": "var(--foreground)",
          "sidebar-primary": "var(--primary)",
          "sidebar-primary-foreground": "var(--foreground)",
          "sidebar-accent": "var(--secondary)",
          "sidebar-accent-foreground": "var(--foreground)",
          "sidebar-border": "var(--border)",
          "sidebar-ring": "var(--ring)"
        },
        "dark": {
          "background": "#1a0b02",
          "foreground": "#fff0e4",
          "card": "#26170a",
          "card-foreground": "var(--foreground)",
          "popover": "var(--card)",
          "popover-foreground": "var(--foreground)",
          "primary-foreground": "var(--background)",
          "secondary": "#36281d",
          "secondary-foreground": "var(--foreground)",
          "muted": "var(--secondary)",
          "muted-foreground": "#b8a79a",
          "accent": "var(--secondary)",
          "accent-foreground": "var(--foreground)",
          "destructive": "#fc452f",
          "destructive-foreground": "var(--background)",
          "border": "#433529",
          "input": "#756659",
          "ring": "var(--primary)",
          "primary-ink": "var(--primary)",
          "success": "#7cc79a",
          "warning": "#e9b949",
          "chart-2": "#fc452f",
          "chart-3": "#c8a27a",
          "chart-4": "#8a7a66",
          "chart-5": "var(--foreground)",
          "sidebar": "#26170ad9",
          "sidebar-foreground": "var(--foreground)",
          "sidebar-primary-foreground": "var(--background)",
          "sidebar-accent": "var(--secondary)",
          "sidebar-accent-foreground": "var(--foreground)",
          "sidebar-border": "var(--border)",
          "sidebar-ring": "var(--ring)"
        }
      },
      "css": {
        "@import \"tw-animate-css\"": {},
        "@import \"shadcn/tailwind.css\"": {},
        "@supports (color: oklch(from red l c h))": {
          ":root": {
            "--background": "oklch(from var(--primary) 0.985 calc(c * 0.06 * var(--surface-tint)) h)",
            "--foreground": "oklch(from var(--primary) 0.18 calc(c * 0.05 * var(--surface-tint)) h)",
            "--card": "oklch(from var(--primary) 0.998 calc(c * 0.02 * var(--surface-tint)) h)",
            "--secondary": "oklch(from var(--primary) 0.95 calc(c * 0.09 * var(--surface-tint)) h)",
            "--muted-foreground": "oklch(from var(--primary) 0.47 calc(c * 0.09 * var(--surface-tint)) h)",
            "--border": "oklch(from var(--primary) 0.91 calc(c * 0.09 * var(--surface-tint)) h)",
            "--input": "oklch(from var(--primary) 0.6 calc(c * 0.06 * var(--surface-tint)) h)",
            "--primary-ink": "oklch(from var(--primary) min(l, 0.55) c h)",
            "--sidebar": "oklch(from var(--primary) 0.975 calc(c * 0.07 * var(--surface-tint)) h / 0.85)"
          },
          ".dark": {
            "--background": "oklch(from var(--primary) 0.17 calc(c * 0.2 * var(--surface-tint)) h)",
            "--foreground": "oklch(from var(--primary) 0.965 calc(c * 0.14 * var(--surface-tint)) h)",
            "--card": "oklch(from var(--primary) 0.22 calc(c * 0.19 * var(--surface-tint)) h)",
            "--secondary": "oklch(from var(--primary) 0.29 calc(c * 0.17 * var(--surface-tint)) h)",
            "--muted-foreground": "oklch(from var(--primary) 0.74 calc(c * 0.16 * var(--surface-tint)) h)",
            "--border": "oklch(from var(--primary) 0.34 calc(c * 0.17 * var(--surface-tint)) h)",
            "--input": "oklch(from var(--primary) 0.52 calc(c * 0.16 * var(--surface-tint)) h)",
            "--primary-ink": "var(--primary)",
            "--sidebar": "oklch(from var(--primary) 0.22 calc(c * 0.19 * var(--surface-tint)) h / 0.85)"
          }
        },
        "@layer base": {
          "*": {
            "@apply border-border outline-ring/50": {}
          },
          "html": {
            "@apply font-sans": {},
            "-webkit-text-size-adjust": "100%",
            "scroll-padding-top": "5.5rem"
          },
          "body": {
            "@apply bg-background text-foreground antialiased": {},
            "line-height": "1.6"
          },
          "h1, h2, h3, h4": {
            "line-height": "1.15",
            "text-wrap": "balance"
          },
          ":focus-visible": {
            "outline": "2px solid var(--ring)",
            "outline-offset": "2px"
          },
          ":where(button, [role=button], [role=checkbox], [role=switch], [role=radio], [role=tab], [role=option], [role=menuitem], [role=menuitemcheckbox], [role=menuitemradio], [role=combobox]:not(input), select, summary, label[for], input[type=checkbox], input[type=radio], input[type=range], input[type=file], input[type=color])": {
            "cursor": "pointer"
          },
          ":where(:disabled, [aria-disabled=true], [data-disabled])": {
            "cursor": "not-allowed"
          }
        },
        "@utility tracking-display": {
          "letter-spacing": "-0.02em"
        },
        "@utility eyebrow": {
          "font-size": "0.75rem",
          "font-weight": "700",
          "letter-spacing": "0.08em",
          "text-transform": "uppercase"
        },
        "@utility tnum": {
          "font-variant-numeric": "tabular-nums"
        },
        "@utility no-scrollbar": {
          "scrollbar-width": "none",
          "&::-webkit-scrollbar": {
            "display": "none"
          }
        },
        "@utility animate-expand": {
          "overflow": "clip",
          "overflow-clip-margin": "4px",
          "&[data-state=open]": {
            "animation": "var(--animate-collapsible-down)"
          },
          "&[data-state=closed]": {
            "animation": "var(--animate-collapsible-up)"
          }
        },
        "@media (prefers-reduced-motion: reduce)": {
          "*, *::before, *::after": {
            "animation-duration": "0.01ms !important",
            "animation-iteration-count": "1 !important",
            "transition-duration": "0.01ms !important",
            "scroll-behavior": "auto !important"
          },
          ".animate-expand": {
            "animation": "none !important"
          }
        }
      }
    },
